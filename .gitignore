# Per-machine agent-tool state. The checked-in .claude/agents/, .claude/commands/,
# and settings.example.json are shared project configuration and stay tracked;
# these two are local to whoever is running the tool.
.claude/settings.local.json
.claude/launch.json

# Local coding-agent harness (master prompts, per-tool agent packs). Useful
# while developing, but it is not part of the product and should not be the
# first thing a reader of this repository sees.
.internal/
