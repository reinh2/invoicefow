# Local-only demo configuration. These are placeholders, not credentials.
DATABASE_URL=postgres://invoiceflow:invoiceflow@127.0.0.1:5432/invoiceflow?sslmode=disable
API_ADDR=127.0.0.1:8080
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
MIGRATIONS_DIR=db/migrations
DEMO_ACTOR=local-demo
# Optional pre-built browser bundle (ADR-013). Leave empty to run the API alone;
# Compose sets it to /app/web so the demo serves the real application.
WEB_DIR=

# Structured-extraction provider (worker only). "fake" (default) is the
# deterministic offline demo and needs no key or network. "openai" opts in to a
# live provider and requires a real OPENAI_API_KEY.
EXTRACTOR=fake
# Put your real key ONLY in a local .env (git-ignored) or your shell — never
# commit it. It is read from the environment by the worker and never logged.
OPENAI_API_KEY=
# Optional overrides. Defaults: gpt-4o-mini and https://api.openai.com/v1.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Public demo settings (ADR-016). Both default to off; leave them off locally.
# PUBLIC_DEMO=true only makes the interface state that the workspace is shared,
# has no sign-in, and is periodically erased. It grants and withholds nothing —
# a public instance still has no authentication. See docs/DEPLOYMENT.md.
PUBLIC_DEMO=false
# Uploads allowed per client address per minute. 0 disables the limit.
UPLOAD_RATE_PER_MINUTE=0
